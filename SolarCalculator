<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generador de Combos Solares Profesionales</title>
    <style>
        :root {
            --primary: #0f766e;
            --secondary: #0d9488;
            --background: #f0fdfa;
            --surface: #ffffff;
            --text: #134e4a;
            --border: #ccfbf1;
        }
        body { font-family: system-ui, sans-serif; background: var(--background); color: var(--text); margin: 0; padding: 20px; }
        .container { max-width: 1000px; margin: 0 auto; background: var(--surface); padding: 24px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        h1, h2 { color: var(--primary); }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 20px; }
        .form-group { display: flex; flex-direction: column; gap: 8px; }
        input, button { padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 1rem; }
        button { background-color: var(--primary); color: white; border: none; cursor: pointer; font-weight: bold; }
        button:hover { background-color: var(--secondary); }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; background: white; }
        th, td { text-align: left; padding: 12px; border-bottom: 1px solid var(--border); }
        th { background-color: #e0f2fe; }
        .delete-btn { background-color: #ef4444; padding: 6px 12px; }
        .combo-panel { margin-top: 32px; padding: 24px; background: white; border: 2px solid var(--primary); border-radius: 8px; }
        .combo-list { list-style: none; padding: 0; margin: 0; }
        .combo-list li { padding: 14px 0; border-bottom: 1px dashed #cbd5e1; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
        .combo-list li:last-child { border-bottom: none; }
        .badge { background: #e2e8f0; padding: 6px 10px; border-radius: 4px; font-size: 0.9rem; font-weight: bold; white-space: nowrap; text-align: right; }
        .highlight { color: #b45309; font-weight: bold; }
        .sub-text { color: #64748b; font-size: 0.85rem; display: block; margin-top: 4px; line-height: 1.4; }
    </style>
</head>
<body>

<div class="container">
    <h1>Armador de Combos Solares Profesionales</h1>
    
    <div class="grid" id="inputForm">
        <div class="form-group">
            <label>Equipo</label>
            <input type="text" id="nombre" placeholder="Ej. PC, Luces">
        </div>
        <div class="form-group">
            <label>Cantidad</label>
            <input type="number" id="cantidad" value="1" min="1">
        </div>
        <div class="form-group">
            <label>Consumo (Watts)</label>
            <input type="number" id="watts" placeholder="W por unidad">
        </div>
        <div class="form-group">
            <label>Horas/Día</label>
            <input type="number" id="horas" placeholder="1 a 24" max="24">
        </div>
        <div class="form-group" style="justify-content: flex-end;">
            <button onclick="agregarEquipo()">Añadir a la lista</button>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Equipo</th>
                <th>Cant.</th>
                <th>Watts c/u</th>
                <th>Horas/Día</th>
                <th>Pico (W)</th>
                <th>Energía (Wh)</th>
                <th></th>
            </tr>
        </thead>
        <tbody id="listaCargas"></tbody>
    </table>

    <div class="combo-panel" id="panelCombo" style="display: none;">
        <h2>📦 Despiece del Combo Requerido</h2>
        <p style="color: #64748b; font-size: 0.9rem;">Calculado para sistema de <span id="sys-volt" class="highlight">12V</span> (Salida a 120V AC).</p>
        <ul class="combo-list" id="listaCombo">
            <!-- El combo se genera dinámicamente aquí -->
        </ul>
    </div>
</div>

<script>
    let equipos = [];

    // Parámetros técnicos comerciales
    const POTENCIA_PANEL = 550; 
    const CAPACIDAD_BATERIA_AH = 200; 
    const VOLTAJE_BATERIA = 12; 
    const DESCARGA_MAXIMA = 0.5; 
    const HORAS_SOL = 4.5;
    const VOLTAJE_AC = 120; // Red eléctrica estándar
    const INVERSORES_COMERCIALES = [1000, 3000, 5000, 8000, 10000];
    
    // Capacidades estándar de breakers en Amperios (Comerciales)
    const BREAKERS_ESTANDAR = [10, 16, 20, 32, 40, 50, 63, 80, 100, 125, 150, 200, 250];

    function obtenerBreaker(amperiosCalculados) {
        return BREAKERS_ESTANDAR.find(b => b >= amperiosCalculados) || Math.ceil(amperiosCalculados/50)*50;
    }

    function agregarEquipo() {
        const nombre = document.getElementById('nombre').value;
        const cantidad = parseInt(document.getElementById('cantidad').value);
        const watts = parseFloat(document.getElementById('watts').value);
        const horas = parseFloat(document.getElementById('horas').value);

        if (!nombre || isNaN(cantidad) || isNaN(watts) || isNaN(horas)) return;

        equipos.push({ id: Date.now(), nombre, cantidad, watts, horas, potenciaPico: cantidad * watts, energiaDiaria: cantidad * watts * horas });
        actualizarUI();
        document.getElementById('nombre').value = ''; document.getElementById('watts').value = ''; document.getElementById('nombre').focus();
    }

    function eliminarEquipo(id) {
        equipos = equipos.filter(e => e.id !== id);
        actualizarUI();
    }

    function actualizarUI() {
        const tbody = document.getElementById('listaCargas');
        tbody.innerHTML = '';
        let totalPico = 0, totalDiario = 0;

        equipos.forEach(eq => {
            totalPico += eq.potenciaPico; totalDiario += eq.energiaDiaria;
            tbody.innerHTML += `<tr><td>${eq.nombre}</td><td>${eq.cantidad}</td><td>${eq.watts} W</td><td>${eq.horas} h</td><td>${eq.potenciaPico} W</td><td>${eq.energiaDiaria} Wh</td><td><button class="delete-btn" onclick="eliminarEquipo(${eq.id})">X</button></td></tr>`;
        });

        if (equipos.length > 0) {
            document.getElementById('panelCombo').style.display = 'block';
            generarCombo(totalPico, totalDiario);
        } else {
            document.getElementById('panelCombo').style.display = 'none';
        }
    }

    function generarCombo(totalPico, totalDiario) {
        // 1. INVERSOR Y VOLTAJE DEL SISTEMA
        let inversorMinimo = totalPico * 1.25; 
        let inversorComercial = INVERSORES_COMERCIALES.find(cap => cap >= inversorMinimo) || (Math.ceil(inversorMinimo / 5000) * 5000); 
        
        let voltajeSistema = 12;
        if (inversorComercial >= 3000 && inversorComercial < 5000) voltajeSistema = 24;
        if (inversorComercial >= 5000) voltajeSistema = 48;
        
        // 2. PANELES SOLARES
        let wattsPanelesRequeridos = (totalDiario / HORAS_SOL) * 1.3; 
        let cantPaneles = Math.max(1, Math.ceil(wattsPanelesRequeridos / POTENCIA_PANEL));
        
        // 3. BATERÍAS
        let energiaUtilPorBateria = VOLTAJE_BATERIA * CAPACIDAD_BATERIA_AH * DESCARGA_MAXIMA;
        let cantBateriasBase = Math.ceil(totalDiario / energiaUtilPorBateria);
        let bateriasEnSerie = voltajeSistema / 12;
        let cantBateriasFinal = Math.ceil(cantBateriasBase / bateriasEnSerie) * bateriasEnSerie;
        if(cantBateriasFinal === 0) cantBateriasFinal = bateriasEnSerie; 

        // 4. CONTROLADOR DE CARGA
        let amperiosControlador = Math.ceil((cantPaneles * POTENCIA_PANEL) / voltajeSistema);
        let esHibrido = inversorComercial >= 3000;
        let controladorTexto = esHibrido ? 
            `Integrado en el Inversor (MPPT)` : 
            `Controlador Externo de ${obtenerBreaker(amperiosControlador)}A`;

        // 5. CÁLCULO DE PROTECCIONES (BREAKERS) Y ATS
        // Margen de seguridad del 25% para no disparar el breaker en uso continuo
        
        // DC Paneles: Amperaje de bajada de paneles al voltaje del sistema
        let ampsDC_Paneles = (cantPaneles * POTENCIA_PANEL) / voltajeSistema;
        let breakerPaneles = obtenerBreaker(ampsDC_Paneles * 1.25);
        
        // DC Baterías: Máximo consumo del inversor jalando de las baterías
        let ampsDC_Baterias = inversorComercial / voltajeSistema;
        let breakerBaterias = obtenerBreaker(ampsDC_Baterias * 1.25);
        
        // AC Salida y Transfer Automático: Consumo en corriente alterna (120V)
        let ampsAC_Salida = inversorComercial / VOLTAJE_AC;
        let breakerAC = obtenerBreaker(ampsAC_Salida * 1.25);
        
        let textoATS = esHibrido ? 
            `<span class="sub-text">El Inversor Híbrido gestiona automáticamente el cambio Red/Baterías.</span>` : 
            `<span class="sub-text">Transfer Automático Externo (ATS) de ${breakerAC}A para cambio automático.</span>`;

        document.getElementById('sys-volt').innerText = `${voltajeSistema}V`;
        
        const lista = document.getElementById('listaCombo');
        lista.innerHTML = `
            <li>
                <div>
                    <strong>⚡ Inversor DC/AC</strong>
                    <span class="sub-text">Onda Senoidal Pura a 120V.</span>
                </div>
                <div class="badge">1 Und x ${inversorComercial}W</div>
            </li>
            <li>
                <div>
                    <strong>🔄 Switch de Transferencia (Luz/Solar)</strong>
                    ${textoATS}
                </div>
                <div class="badge">${esHibrido ? 'Integrado' : '1 Und (ATS Externo)'}</div>
            </li>
            <li>
                <div>
                    <strong>🔋 Banco de Baterías</strong>
                    <span class="sub-text">Ciclo profundo (${VOLTAJE_BATERIA}V ${CAPACIDAD_BATERIA_AH}Ah). Banco configurado a ${voltajeSistema}V.</span>
                </div>
                <div class="badge">${cantBateriasFinal} Und(s)</div>
            </li>
            <li>
                <div>
                    <strong>☀️ Paneles Solares</strong>
                    <span class="sub-text">Módulos de alta eficiencia de ${POTENCIA_PANEL}W.</span>
                </div>
                <div class="badge">${cantPaneles} Und(s)</div>
            </li>
            <li>
                <div>
                    <strong>🎛️ Controlador de Carga</strong>
                    <span class="sub-text">Gestiona la energía fotovoltaica.</span>
                </div>
                <div class="badge">${controladorTexto}</div>
            </li>
            <li>
                <div>
                    <strong>🛡️ Breaker DC (Paneles)</strong>
                    <span class="sub-text">Corte y protección entre paneles y controlador.</span>
                </div>
                <div class="badge">Breaker DC ${breakerPaneles}A</div>
            </li>
            <li>
                <div>
                    <strong>🛡️ Breaker DC (Baterías)</strong>
                    <span class="sub-text">Corte y protección principal del banco de baterías.</span>
                </div>
                <div class="badge">Breaker DC ${breakerBaterias}A</div>
            </li>
            <li>
                <div>
                    <strong>🛡️ Breaker AC (Salida 120V)</strong>
                    <span class="sub-text">Protección hacia el tablero o cargas de la empresa.</span>
                </div>
                <div class="badge">Breaker AC ${breakerAC}A</div>
            </li>
            <li>
                <div>
                    <strong>🔌 Cableado y Conexiones</strong>
                    <span class="sub-text">Cable solar especial UV y empalmes.</span>
                </div>
                <div class="badge">30m Cable + ${cantPaneles} Par(es) MC4</div>
            </li>
        `;
    }
</script>

</body>
</html>
